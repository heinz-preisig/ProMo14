@prefix promo: <https://w3id.org/promo#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/promo/model> {
    promo:Assignment a rdfs:Class .

    promo:Composite a rdfs:Class .

    promo:Glass a rdfs:Class .

    promo:Instantiation a rdfs:Class .

    promo:Library a rdfs:Class .

    promo:Model a rdfs:Class .

    promo:ModelArc a rdfs:Class .

    promo:ModelNode a rdfs:Class .

    promo:Ontology a rdfs:Class .

    promo:Species a rdfs:Class .

    promo:ValueCell a rdfs:Class ;
        promo:doc "One entry of a variable's value table (§20 ν channel).  The variable links it via promo:valueCell; the cell carries promo:value (literal scalar), promo:coordinate (JSON list of index-element IRIs ordered by the variable's indexStructure) and promo:atIndexElement links.  See docs/value-cells.md." .

    promo:ValueFill a rdfs:Class ;
        promo:doc "A fill rule covering many cells of a variable's value table at once — the '*' selector mechanism for mostly-uniform tables.  The variable links it via promo:valueFill; the fill carries promo:fillPattern (JSON list of element IRIs and '*' segments in indexStructure order) and promo:value.  Resolved to concrete cells at plan() time.  See docs/value-fill.md." .

    promo:Version a rdfs:Class .

    promo:arcCounter a rdf:Property .

    promo:arcType a rdf:Property .

    promo:atIndexElement a rdf:Property ;
        promo:doc "promo:ValueCell → index element IRI, for graph navigation.  Unordered — the authoritative element order is the cell's promo:coordinate literal." .

    promo:children a rdf:Property .

    promo:coordinate a rdf:Property ;
        promo:doc "On a promo:ValueCell: JSON list of index-element IRIs ordered by the variable's indexStructure — the authoritative cell coordinate.  Flat enumerations of a table walk the coordinate product last-index-fastest (C order).  See docs/value-cells.md." .

    promo:doc a rdf:Property .

    promo:entityType a rdf:Property .

    promo:fillPattern a rdf:Property ;
        promo:doc "On a promo:ValueFill: JSON list like promo:coordinate but with '*' allowed per segment — '*' matches every element on that axis.  The most specific matching selector wins; equal-specificity overlaps are fill-conflict problems.  See docs/value-fill.md." .

    promo:generatedFrom a rdf:Property .

    promo:hasSubPlan a rdf:Property .

    promo:instantiates a rdf:Property .

    promo:internalID a rdf:Property .

    promo:knots a rdf:Property .

    promo:layout a rdf:Property .

    promo:nextTreeId a rdf:Property .

    promo:occurrencePath a rdf:Property .

    promo:overrides a rdf:Property .

    promo:publishedOn a rdf:Property .

    promo:referenceFrom a rdf:Property .

    promo:referenceTo a rdf:Property .

    promo:rootComposite a rdf:Property .

    promo:seedFloor a rdf:Property .

    promo:source a rdf:Property .

    promo:target a rdf:Property .

    promo:usesAssignment a rdf:Property .

    promo:usesLibrary a rdf:Property .

    promo:usesOntology a rdf:Property .

    promo:usesSpecies a rdf:Property .

    promo:usesValues a rdf:Property .

    promo:value a rdf:Property ;
        promo:doc "Literal scalar payload — a constant's pre-bound value (ADR-008) or a promo:ValueCell's value.  Never an expression: computed values are promo:Expression trees behind promo:rhsExpression or 'initialise'-class equations." .

    promo:valueCell a rdf:Property ;
        promo:doc "Variable → promo:ValueCell: the variable's value table — ν parameter tables and initial-condition pins.  See docs/value-cells.md." .

    promo:valueFill a rdf:Property ;
        promo:doc "Variable → promo:ValueFill: a fill rule covering a region of the variable's value table.  See docs/value-fill.md." .

    promo:versionInfo a rdf:Property .

    promo:versionOf a rdf:Property .

    <https://w3id.org/promo/library#V_39> promo:valueCell <https://w3id.org/promo/model#cell_5ab8d9c81ba8> .

    <https://w3id.org/promo/library#V_54> promo:valueCell <https://w3id.org/promo/model#cell_5ca2f9aa8552> .

    <https://w3id.org/promo/library#V_57> promo:valueCell <https://w3id.org/promo/model#cell_130f61d593c2>,
            <https://w3id.org/promo/model#cell_54a444ab40f2>,
            <https://w3id.org/promo/model#cell_bdb3b16d5bba> .

    <https://w3id.org/promo/library#V_58> promo:valueCell <https://w3id.org/promo/model#cell_5a41d0456ee2> .

    <https://w3id.org/promo/model> a promo:Model ;
        rdfs:label "test_01" ;
        promo:usesAssignment <https://w3id.org/promo/library/assignments> ;
        promo:usesLibrary <https://w3id.org/promo/library> ;
        promo:usesOntology <https://w3id.org/promo/ontology> .

    <https://w3id.org/promo/model/Model> a promo:Model ;
        promo:arcCounter 3 ;
        promo:nextTreeId 3 ;
        promo:rootComposite <https://w3id.org/promo/model/Composite_0> .

    <https://w3id.org/promo/ontology#V_21> promo:valueCell <https://w3id.org/promo/model#cell_02f215ea8d8b> .

    <https://w3id.org/promo/ontology#V_22> promo:valueCell <https://w3id.org/promo/model#cell_a3caf79fea42> .

    <https://w3id.org/promo/ontology#V_34> promo:valueCell <https://w3id.org/promo/model#cell_02ea507ec31c>,
            <https://w3id.org/promo/model#cell_cc4938a4db2a> .

    <https://w3id.org/promo/model#cell_02ea507ec31c> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Node_3> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Node_3\"]" ;
        promo:value 1 .

    <https://w3id.org/promo/model#cell_02f215ea8d8b> a promo:ValueCell ;
        promo:coordinate "[]" ;
        promo:value 0 .

    <https://w3id.org/promo/model#cell_130f61d593c2> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Arc_2>,
            <https://w3id.org/promo/model/Node_2> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Arc_2\", \"https://w3id.org/promo/model/Node_2\"]" ;
        promo:value 0 .

    <https://w3id.org/promo/model#cell_54a444ab40f2> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Arc_2>,
            <https://w3id.org/promo/model/Node_3> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Arc_2\", \"https://w3id.org/promo/model/Node_3\"]" ;
        promo:value 0 .

    <https://w3id.org/promo/model#cell_5a41d0456ee2> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Arc_2>,
            <https://w3id.org/promo/model/Node_3> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Arc_2\", \"https://w3id.org/promo/model/Node_3\"]" ;
        promo:value 0 .

    <https://w3id.org/promo/model#cell_5ab8d9c81ba8> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Node_2> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Node_2\"]" ;
        promo:value 1 .

    <https://w3id.org/promo/model#cell_5ca2f9aa8552> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Node_2> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Node_2\"]" ;
        promo:value 10 .

    <https://w3id.org/promo/model#cell_a3caf79fea42> a promo:ValueCell ;
        promo:coordinate "[]" ;
        promo:value 100 .

    <https://w3id.org/promo/model#cell_bdb3b16d5bba> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Arc_1>,
            <https://w3id.org/promo/model/Node_2> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Arc_1\", \"https://w3id.org/promo/model/Node_2\"]" ;
        promo:value 0 .

    <https://w3id.org/promo/model#cell_cc4938a4db2a> a promo:ValueCell ;
        promo:atIndexElement <https://w3id.org/promo/model/Node_1> ;
        promo:coordinate "[\"https://w3id.org/promo/model/Node_1\"]" ;
        promo:value 5 .

    <https://w3id.org/promo/model/Arc_1> a promo:ModelArc ;
        promo:arcType <https://w3id.org/promo#ArcType/token-flow> ;
        promo:internalID "Arc_1" ;
        promo:referenceFrom <https://w3id.org/promo/model/Node_1> ;
        promo:referenceTo <https://w3id.org/promo/model/Node_2> ;
        promo:source <https://w3id.org/promo/model/Node_1> ;
        promo:target <https://w3id.org/promo/model/Node_2> .

    <https://w3id.org/promo/model/Composite_0> a promo:Composite ;
        rdfs:label "Root" ;
        promo:children "[{\"id\": 1, \"iri\": \"https://w3id.org/promo/model/Node_1\"}, {\"id\": 2, \"iri\": \"https://w3id.org/promo/model/Node_2\"}, {\"id\": 3, \"iri\": \"https://w3id.org/promo/model/Node_3\"}]" ;
        promo:internalID 0 ;
        promo:layout "{\"1\": {\"x\": -139.5, \"y\": -197.5}, \"2\": {\"x\": 8.666671752929688, \"y\": -195.5}, \"3\": {\"x\": 139.5, \"y\": -200.5}}" .

    <https://w3id.org/promo/model/Arc_2> a promo:ModelArc ;
        promo:arcType <https://w3id.org/promo#ArcType/token-flow> ;
        promo:internalID "Arc_2" ;
        promo:referenceFrom <https://w3id.org/promo/model/Node_2> ;
        promo:referenceTo <https://w3id.org/promo/model/Node_3> ;
        promo:source <https://w3id.org/promo/model/Node_2> ;
        promo:target <https://w3id.org/promo/model/Node_3> .

    <https://w3id.org/promo/model/Node_1> a promo:ModelNode ;
        rdfs:label "Node 1" ;
        promo:entityType <https://w3id.org/promo/ontology#etype_environment> ;
        promo:internalID "Node_1" .

    <https://w3id.org/promo/model/Node_3> a promo:ModelNode ;
        rdfs:label "Node 3" ;
        promo:entityType <https://w3id.org/promo/ontology#etype_lumped> ;
        promo:internalID "Node_3" .

    <https://w3id.org/promo/model/Node_2> a promo:ModelNode ;
        rdfs:label "Node 2" ;
        promo:entityType <https://w3id.org/promo/ontology#etype_convection_transport> ;
        promo:internalID "Node_2" .
}

