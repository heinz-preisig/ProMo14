    <https://w3id.org/promo/library#E_12> a promo:Equation ;
        promo:created "2026-10-31T15:40:09.904Z" ;
        promo:doc "convective mass conductivity, x leg — sum_S(Mm/mu) * (dU/dp)/V times the x velocity component; the flow-law coefficient in fmc" ;
        promo:equationClass <https://w3id.org/promo/ontology#eqclass_generic> ;
        promo:inDomain <https://w3id.org/promo/ontology#domain_macroscopic> ;
        promo:incidenceList "[\"https://w3id.org/promo/library#V_10\", \"https://w3id.org/promo/library#V_116\", \"https://w3id.org/promo/library#V_23\", \"https://w3id.org/promo/library#V_35\", \"https://w3id.org/promo/ontology#V_12\", \"https://w3id.org/promo/ontology#V_5\", \"https://w3id.org/promo/ontology#e_x\"]" ;
        promo:internalID "E_12" ;
        promo:lhs <https://w3id.org/promo/library#V_39> ;
        promo:modified "2026-10-31T15:40:09.904Z" ;
        promo:network "macroscopic" ;
        promo:rhs "( ( ( reduceSum( ( properties!Mm * inv( physical!mu ) ), S ) * inv( physical!V ) ) * ParDiff( physical!U, physical!p_term ) ) * reduceSum( ( physical!e_x * v ), C ) )" ;
        promo:rhsExpression <https://w3id.org/promo/library#E_12/expression> ;
        promo:rhsLatex "\\left( \\left( \\left( \\sum_{S} \\left( {\\lambda}_{S} \\circ {{\\mu}_{N,S}}^{-1} \\right) \\circ {{V}_{N}}^{-1} \\right) \\circ \\frac{\\partial {U}_{N}}{\\partial {p}_{N}} \\right) \\circ \\sum_{C} \\left( e_{x,C} \\circ {v}_{C,N} \\right) \\right)" .

