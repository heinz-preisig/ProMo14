        promo:doc "Darcy-Weisbach dissipated power per contact — λ·(L/d)·ṁ·v²/2 (§46 follow-up: constitutive law replacing the imposed port)." ;
        promo:equationClass <https://w3id.org/promo/ontology#eqclass_generic> ;
        promo:inDomain <https://w3id.org/promo/ontology#domain_macroscopic> ;
        promo:incidenceList "[\"https://w3id.org/promo/library#V_122\", \"https://w3id.org/promo/library#V_123\", \"https://w3id.org/promo/library#V_124\", \"https://w3id.org/promo/library#V_125\", \"https://w3id.org/promo/library#V_56\", \"https://w3id.org/promo/ontology#const_half\"]" ;
        promo:internalID "E_fl" ;
        promo:lhs <https://w3id.org/promo/library#V_109> ;
        promo:network "macroscopic" ;
        promo:rhs "( ( half * macroscopic!lam ) * ( ( macroscopic!Lp * inv( macroscopic!dp ) ) * ( macroscopic!fmc * reduceSum( ( macroscopic!v_str * macroscopic!v_str ), C ) ) ) )" ;
        promo:rhsExpression <https://w3id.org/promo/library#E_fl/expression> ;
        promo:rhsLatex "\\left( \\left( \\frac{1}{2} \\circ {\\lambda}_{A\\_conv} \\right) \\circ \\left( \\left( {L}_{A\\_conv} \\circ {{d}_{p,A\\_conv}}^{-1} \\right) \\circ \\left( {\\hat{m}^c}_{A\\_conv,N} \\circ \\sum_{C} \\left( {{v}^{s}}_{A\\_conv,C,N} \\circ {{v}^{s}}_{A\\_conv,C,N} \\right) \\right) \\right) \\right)" .

