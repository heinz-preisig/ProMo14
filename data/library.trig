        promo:network "macroscopic" ;
        promo:rhs "( physical!e_align * ( sign( reduceSum( ( physical!sigma * physical!p_mech ), X ) ) * sqrt( ( abs( reduceSum( ( physical!sigma * physical!p_mech ), X ) ) * ( ( macroscopic!dp * inv( macroscopic!lam ) ) * ( inv( macroscopic!Lp ) * ( inv( properties!rho ) * inv( universe!half ) ) ) ) ) ) ) )" ;
        promo:rhsExpression <https://w3id.org/promo/library#E_v_str_darcy/expression> ;
        promo:rhsLatex "\\left( e_{a,C,X} \\circ \\left( \\mathrm{sign}\\left( \\sum_{X} \\left( {\\sigma}_{X} \\circ p_{\\mathrm{m},N} \\right) \\right) \\circ \\sqrt{\\left( \\left| \\sum_{X} \\left( {\\sigma}_{X} \\circ p_{\\mathrm{m},N} \\right) \\right| \\circ \\left( \\left( {d}_{p,A\\_conv} \\circ {{\\lambda}_{A\\_conv}}^{-1} \\right) \\circ \\left( {{L}_{A\\_conv}}^{-1} \\circ \\left( {{\\rho}_{N}}^{-1} \\circ {\\frac{1}{2}}^{-1} \\right) \\right) \\right) \\right)} \\right) \\right)" .

