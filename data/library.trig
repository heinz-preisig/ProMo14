    <https://w3id.org/promo/library#E_v_str> a promo:Equation ;
        promo:doc "stream velocity = (conductance/rho) * pressure drop, projected onto components — the contact's mass-driven velocity in vector form" ;
        promo:equationClass <https://w3id.org/promo/ontology#eqclass_generic> ;
        promo:inDomain <https://w3id.org/promo/ontology#domain_macroscopic> ;
        promo:incidenceList "[\"https://w3id.org/promo/library#V_39\", \"https://w3id.org/promo/library#V_73\", \"https://w3id.org/promo/ontology#V_34\", \"https://w3id.org/promo/ontology#e_align\", \"https://w3id.org/promo/ontology#sigma\"]" ;
        promo:internalID "E_74" ;
        promo:lhs <https://w3id.org/promo/library#V_122> ;
        promo:network "macroscopic" ;
        promo:rhs "( physical!e_align * ( ( kConvX * inv( properties!rho ) ) * reduceSum( ( physical!sigma * physical!p_mech ), X ) ) )" ;
        promo:rhsExpression <https://w3id.org/promo/library#E_v_str/expression> ;
        promo:rhsLatex "\\left( e_{a,C,X} \\circ \\left( \\left( {k^c}_{x,N} \\circ {{\\rho}_{N}}^{-1} \\right) \\circ \\sum_{X} \\left( {\\sigma}_{X} \\circ p_{\\mathrm{m},N} \\right) \\right) \\right)" .

    <https://w3id.org/promo/library#E_v_str/expression> a promo:Expression ;
        promo:hasArguments _:n19cc9b5154604b7fa7e4b6d3410b2b86b83 ;
        promo:hasOperation promolg:IndexPreservingProduct .

    <https://w3id.org/promo/library#E_v_str_darcy> a promo:Equation ;
        promo:doc "stream velocity under the Darcy-Weisbach law — alternative to E_v_str (linear kConvX conductance): v = sign(Δp)·√(|Δp|·dp/(λ·Lp·ρ·½)) — quadratic Δp∝v² regime; the BL sequence picks one." ;
        promo:equationClass <https://w3id.org/promo/ontology#eqclass_generic> ;
        promo:inDomain <https://w3id.org/promo/ontology#domain_macroscopic> ;
        promo:incidenceList "[\"https://w3id.org/promo/library#V_123\", \"https://w3id.org/promo/library#V_124\", \"https://w3id.org/promo/library#V_125\", \"https://w3id.org/promo/library#V_73\", \"https://w3id.org/promo/ontology#V_34\", \"https://w3id.org/promo/ontology#const_half\", \"https://w3id.org/promo/ontology#e_align\", \"https://w3id.org/promo/ontology#sigma\"]" ;
