@prefix promo: <https://w3id.org/promo#> .
@prefix promolg: <https://w3id.org/promo/language#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/promo/library> {
    promo:Assignment a rdfs:Class .

    promo:Equation a rdfs:Class .

    promo:Expression a rdfs:Class .

    promo:Glass a rdfs:Class .

    promo:Instantiation a rdfs:Class .

    promo:Library a rdfs:Class .

    promo:Model a rdfs:Class .

    promo:Ontology a rdfs:Class .

    promo:Species a rdfs:Class .

    promo:ValueCell a rdfs:Class ;
        promo:doc "One entry of a variable's value table (§20 ν channel).  The variable links it via promo:valueCell; the cell carries promo:value (literal scalar), promo:coordinate (JSON list of index-element IRIs ordered by the variable's indexStructure) and promo:atIndexElement links.  See docs/value-cells.md." .

    promo:ValueFill a rdfs:Class ;
        promo:doc "A fill rule covering many cells of a variable's value table at once — the '*' selector mechanism for mostly-uniform tables.  The variable links it via promo:valueFill; the fill carries promo:fillPattern (JSON list of element IRIs and '*' segments in indexStructure order) and promo:value.  Resolved to concrete cells at plan() time.  See docs/value-fill.md." .

    promo:Variable a rdfs:Class .

    promo:Version a rdfs:Class .

    promo:aliases a rdf:Property .

    promo:atIndexElement a rdf:Property ;
        promo:doc "promo:ValueCell → index element IRI, for graph navigation.  Unordered — the authoritative element order is the cell's promo:coordinate literal." .

    promo:axisValue a rdf:Property .

    promo:carriesToken a rdf:Property .

    promo:coordinate a rdf:Property ;
        promo:doc "On a promo:ValueCell: JSON list of index-element IRIs ordered by the variable's indexStructure — the authoritative cell coordinate.  Flat enumerations of a table walk the coordinate product last-index-fastest (C order).  See docs/value-cells.md." .

    promo:created a rdf:Property .

    promo:doc a rdf:Property .

    promo:equationClass a rdf:Property .

    promo:fillPattern a rdf:Property ;
        promo:doc "On a promo:ValueFill: JSON list like promo:coordinate but with '*' allowed per segment — '*' matches every element on that axis.  The most specific matching selector wins; equal-specificity overlaps are fill-conflict problems.  See docs/value-fill.md." .

    promo:frozen a rdf:Property .

    promo:generatedFrom a rdf:Property .

    promo:hasArguments a rdf:Property .

    promo:hasEquation a rdf:Property .

    promo:hasOperation a rdf:Property .

    promo:hasSubPlan a rdf:Property .

    promo:imported a rdf:Property .

    promo:inDomain a rdf:Property .

    promo:incidenceList a rdf:Property .

    promo:indexStructure a rdf:Property .

    promo:instantiates a rdf:Property .

    promo:internalID a rdf:Property .

    promo:latex a rdf:Property .

    promo:lhs a rdf:Property .

    promo:modified a rdf:Property .

    promo:network a rdf:Property .

    promo:occurrencePath a rdf:Property .

    promo:overrides a rdf:Property .

    promo:portVariable a rdf:Property .

    promo:publishedOn a rdf:Property .

    promo:rhs a rdf:Property .

    promo:rhsExpression a rdf:Property .

    promo:rhsLatex a rdf:Property .

    promo:seedFloor a rdf:Property .

    promo:tokenVector a rdf:Property .

    promo:unitVector a rdf:Property .

    promo:usesAssignment a rdf:Property .

    promo:usesLibrary a rdf:Property .

    promo:usesOntology a rdf:Property .

    promo:usesSpecies a rdf:Property .

    promo:usesValues a rdf:Property .

    promo:valueCell a rdf:Property ;
        promo:doc "Variable → promo:ValueCell: the variable's value table — ν parameter tables and initial-condition pins.  See docs/value-cells.md." .

    promo:valueFill a rdf:Property ;
        promo:doc "Variable → promo:ValueFill: a fill rule covering a region of the variable's value table.  See docs/value-fill.md." .

    promo:versionInfo a rdf:Property .

    promo:versionOf a rdf:Property .

    <https://w3id.org/promo/library> a promo:Library ;
        promo:usesOntology <https://w3id.org/promo/ontology> .

    <https://w3id.org/promo/library#V_60> a promo:Variable ;
        rdfs:label "value" ;
