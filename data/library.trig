        promo:created "2026-09-25T13:03:39.862Z" ;
        promo:doc "flow direction selector: sign of the sigma-weighted pressure drop across the contact — drives the upwind terms (cac, cfV)" ;
        promo:equationClass <https://w3id.org/promo/ontology#eqclass_generic> ;
        promo:inDomain <https://w3id.org/promo/ontology#domain_macroscopic> ;
        promo:incidenceList "[\"https://w3id.org/promo/ontology#V_34\", \"https://w3id.org/promo/ontology#sigma\"]" ;
        promo:internalID "E_11" ;
        promo:lhs <https://w3id.org/promo/library#V_26> ;
        promo:modified "2026-11-03T21:45:00.000Z" ;
        promo:network "macroscopic" ;
        promo:rhs "sign( reduceSum( ( physical!sigma * physical!p_mech ), X ) )" ;
        promo:rhsExpression <https://w3id.org/promo/library#E_11/expression> ;
        promo:rhsLatex "\\mathrm{sign}\\left( \\sum_{X} \\left( {\\sigma}_{X} \\circ p_{\\mathrm{m},N} \\right) \\right)" .

